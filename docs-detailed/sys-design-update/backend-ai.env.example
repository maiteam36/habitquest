# PROPOSED CONFIGURATION — implementation-plan artifact, November 4, 2026.
# The current backend does NOT support all settings below. Implement typed
# settings/routing first, then merge into backend/.env.example and private .env.
# Do not replace the existing .env with this file. Preserve database/auth/CORS,
# dev-login/JWT and the existing OPENAI_* provider settings for legacy features.
# Never commit real credentials, put them in VITE_* variables, or print .env.
# See ai-configuration-handoff.md for source-to-target mapping and activation.

# EXECUTION MODES (proposed refined/local values are not supported today).
# Safe template: no paid calls. Enable AI_MODE=openai and RETRIEVAL_MODE=pinecone
# only for the implemented live phase with valid provider settings.
AI_MODE=fake
COACH_ENGINE=refined
RETRIEVAL_MODE=local

# IMPORTED OPENAI PROVIDER — shared by Coach, habit generation and embeddings.
# Copy ONLY the planning-agent/.env OPENAI_API_KEY value into the blank below.
# Do NOT overwrite backend/.env OPENAI_API_KEY: it currently serves Nebius.
# Do NOT point this group at the legacy Nebius endpoint.
PLANNING_OPENAI_BASE_URL=https://api.openai.com/v1
PLANNING_OPENAI_API_KEY=

# HABIT COACH: replaces the prototype's recommendation-generation role.
# The normal graph has a separate ParentRisk call and full-payload Safety call.
COACH_MODEL=gpt-6-luna
COACH_API_MODE=responses
COACH_REASONING_EFFORT=low
COACH_MAX_OUTPUT_TOKENS=1600
COACH_REQUEST_TIMEOUT_SECONDS=30
# Preserve the main Coach's existing SDK retry setting initially.
# This is NOT the generation-revision budget.
COACH_MAX_RETRIES=1
# Preserve the current local overall turn budget until measured tuning.
COACH_TIMEOUT_SECONDS=65

# GENERATED HABITS: prototype action writer, invoked only by Generate habits.
# Uses PLANNING_OPENAI_* above. A goal-detail read makes no generation call.
HABIT_GENERATION_MODEL=gpt-6-luna
HABIT_GENERATION_API_MODE=responses
HABIT_GENERATION_REASONING_EFFORT=low
HABIT_GENERATION_TIMEOUT_SECONDS=45
HABIT_GENERATION_MAX_RETRIES=0
# This is a FLOOR, not the whole response ceiling. Preserve count-aware sizing:
# max(floor, 800 + 1100 * requested_count); 3 habits currently require 4100.
HABIT_GENERATION_TOKEN_FLOOR=2800
HABIT_GENERATION_EVAL_CAPTURE=false
# Both Responses clients retain store=False. Do not copy the old five-call
# PLANNER_MAX_MODEL_CALLS harness loop into the new graph.

# RETAINED SAFETY ROLES — use EXISTING main OPENAI_BASE_URL / OPENAI_API_KEY.
# These explicitly preserve today's resolved models, rather than inheriting
# Luna through a changed primary model. Keep existing low-effort/schema behavior.
PARENT_RISK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
OUTPUT_SAFETY_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Leave OPENAI_MODEL / OPENAI_SMALL_MODEL / OPENAI_SAFETY_MODEL and other
# legacy feature settings intact. Reports and child moderation keep their route.

# EMBEDDINGS — use PLANNING_OPENAI_* explicitly, never the legacy chat key/base.
# Must match the existing document embedding space. Changing either value
# requires a deliberate index/catalog migration, not just an env edit.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=0

# PINECONE — copy key + exact verified data-plane host from planning-agent/.env.
# Host is a hostname (no https:// prefix), matching the existing retriever.
# This configuration reads the existing index; it never creates/populates one.
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX_NAME=hq-habits-v1
PINECONE_NAMESPACE=habits-0-1-0
PINECONE_API_VERSION=2026-07
PINECONE_METRIC=cosine
PINECONE_VECTOR_FIELD=embedding
PINECONE_TIMEOUT_SECONDS=15
# Setup expectations only, not runtime index provisioning settings:
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# CANONICAL CATALOG — set the real main-app packaged-release pointer path.
# Source today: hq-infra-setup/pinecone-data-updates/datasets/current.json.
# Relative paths must resolve from the configured backend root. A sibling-only
# development path is not a deployable artifact. Keep hashes/release checks.
CATALOG_VERSION=0.1.0
CATALOG_SNAPSHOT_POINTER=/absolute/path/to/packaged-catalog/current.json

# TLS — existing macOS trust path; choose a valid CA path on another host.
# Never disable certificate verification to make a provider request succeed.
SSL_CERT_FILE=/etc/ssl/cert.pem

# DEVELOPMENT SPENDING GUARD — retain accounted/reserved usage when migrating.
# The source private cap is 1.00; its public example's 0.10 is a different value.
# These settings do not authorize spending and are not production billing.
# Define one ledger owner; do not run two writers against the prototype ledger.
# Do not initialize an empty ledger to bypass already-used source budget.
PLANNING_TEST_BUDGET_USD=1.00
# Ledger location/ownership and usage transfer are required implementation work.
# Existing source: planning-agent/reports/live-usage.json; keep it intact.
# Accounting estimates copied from source config, NOT newly verified prices:
PLANNING_INPUT_RATE_PER_MILLION=0.10
PLANNING_OUTPUT_RATE_PER_MILLION=0.50
# The prototype excludes Pinecone charges and uses conservative embedding cost
# reservations. Document that limit rather than calling this a complete bill.

# PRIVACY / TRACING — unchanged defaults; no raw family data sent to tracing.
TRACE_COACH=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Main family authentication/history replaces PLANNER_SESSION_TTL_SECONDS and
# PLANNER_MAX_SESSIONS. Do not copy those into auth-token or retention settings.
# Keep the main AI_DAILY_LIMIT and other existing app settings unchanged.
